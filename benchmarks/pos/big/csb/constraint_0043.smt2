; Formula constraint
(assert (and (not (= a14_1_2 (bvsub a14_1_5 #b111111111000010))) (or (=> (bvslt (bvadd a14_2_1 a14_3_5) (bvmul #b111111111110011 a14_1_1)) (bvsge a14_0_3 (bvsub h1_i4 (bvmul #b111111111011110 a14_0_5)))) (bvsle a14_0_4 #b000000000000100))))

