(set-logic QF_BV)

; Bit width chosen: 11 (covers range [133, 974] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a1_0 (_ BitVec 11))
(declare-const a1_1 (_ BitVec 11))
(declare-const a1_2 (_ BitVec 11))
(declare-const a4_0_0 (_ BitVec 11))
(declare-const a4_0_1 (_ BitVec 11))
(declare-const a4_0_2 (_ BitVec 11))
(declare-const a4_0_3 (_ BitVec 11))
(declare-const a4_0_4 (_ BitVec 11))
(declare-const a4_1_0 (_ BitVec 11))
(declare-const a4_1_1 (_ BitVec 11))
(declare-const a4_1_2 (_ BitVec 11))
(declare-const a4_1_3 (_ BitVec 11))
(declare-const a4_1_4 (_ BitVec 11))
(declare-const a4_2_0 (_ BitVec 11))
(declare-const a4_2_1 (_ BitVec 11))
(declare-const a4_2_2 (_ BitVec 11))
(declare-const a4_2_3 (_ BitVec 11))
(declare-const a4_2_4 (_ BitVec 11))
(declare-const a4_3_0 (_ BitVec 11))
(declare-const a4_3_1 (_ BitVec 11))
(declare-const a4_3_2 (_ BitVec 11))
(declare-const a4_3_3 (_ BitVec 11))
(declare-const a4_3_4 (_ BitVec 11))
(declare-const i3 (_ BitVec 11))

; Domain constraints
(assert (or (= a1_0 #b00100100001) (= a1_0 #b00101010010) (= a1_0 #b01010011111) (= a1_0 #b01100101010) (= a1_0 #b01111001110)))
(assert (or (= a1_1 #b00100100001) (= a1_1 #b00101010010) (= a1_1 #b01010011111) (= a1_1 #b01100101010) (= a1_1 #b01111001110)))
(assert (or (= a1_2 #b00100100001) (= a1_2 #b00101010010) (= a1_2 #b01010011111) (= a1_2 #b01100101010) (= a1_2 #b01111001110)))
(assert (and (bvsge a4_0_0 #b01100111001) (bvsle a4_0_0 #b01110111101)))
(assert (and (bvsge a4_0_1 #b01100111001) (bvsle a4_0_1 #b01110111101)))
(assert (and (bvsge a4_0_2 #b01100111001) (bvsle a4_0_2 #b01110111101)))
(assert (and (bvsge a4_0_3 #b01100111001) (bvsle a4_0_3 #b01110111101)))
(assert (and (bvsge a4_0_4 #b01100111001) (bvsle a4_0_4 #b01110111101)))
(assert (and (bvsge a4_1_0 #b01100111001) (bvsle a4_1_0 #b01110111101)))
(assert (and (bvsge a4_1_1 #b01100111001) (bvsle a4_1_1 #b01110111101)))
(assert (and (bvsge a4_1_2 #b01100111001) (bvsle a4_1_2 #b01110111101)))
(assert (and (bvsge a4_1_3 #b01100111001) (bvsle a4_1_3 #b01110111101)))
(assert (and (bvsge a4_1_4 #b01100111001) (bvsle a4_1_4 #b01110111101)))
(assert (and (bvsge a4_2_0 #b01100111001) (bvsle a4_2_0 #b01110111101)))
(assert (and (bvsge a4_2_1 #b01100111001) (bvsle a4_2_1 #b01110111101)))
(assert (and (bvsge a4_2_2 #b01100111001) (bvsle a4_2_2 #b01110111101)))
(assert (and (bvsge a4_2_3 #b01100111001) (bvsle a4_2_3 #b01110111101)))
(assert (and (bvsge a4_2_4 #b01100111001) (bvsle a4_2_4 #b01110111101)))
(assert (and (bvsge a4_3_0 #b01100111001) (bvsle a4_3_0 #b01110111101)))
(assert (and (bvsge a4_3_1 #b01100111001) (bvsle a4_3_1 #b01110111101)))
(assert (and (bvsge a4_3_2 #b01100111001) (bvsle a4_3_2 #b01110111101)))
(assert (and (bvsge a4_3_3 #b01100111001) (bvsle a4_3_3 #b01110111101)))
(assert (and (bvsge a4_3_4 #b01100111001) (bvsle a4_3_4 #b01110111101)))
(assert (and (bvsge i3 #b00010000101) (bvsle i3 #b01000000111)))

; Formula constraint
(assert (not (not (and (bvsgt a4_3_2 a4_0_1) (not (= a4_3_2 a4_0_3))))))

(check-sat)