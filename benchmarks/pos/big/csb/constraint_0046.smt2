(set-logic QF_BV)

; Bit width chosen: 11 (covers range [30, 927] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a1_0_a5_0 (_ BitVec 11))
(declare-const a1_0_a5_1 (_ BitVec 11))
(declare-const a1_0_a5_2 (_ BitVec 11))
(declare-const a1_0_a5_3 (_ BitVec 11))
(declare-const a1_0_a5_4 (_ BitVec 11))
(declare-const a1_0_i3 (_ BitVec 11))
(declare-const a1_0_i7 (_ BitVec 11))
(declare-const a1_1_a5_0 (_ BitVec 11))
(declare-const a1_1_a5_1 (_ BitVec 11))
(declare-const a1_1_a5_2 (_ BitVec 11))
(declare-const a1_1_a5_3 (_ BitVec 11))
(declare-const a1_1_a5_4 (_ BitVec 11))
(declare-const a1_1_i3 (_ BitVec 11))
(declare-const a1_1_i7 (_ BitVec 11))
(declare-const a1_2_a5_0 (_ BitVec 11))
(declare-const a1_2_a5_1 (_ BitVec 11))
(declare-const a1_2_a5_2 (_ BitVec 11))
(declare-const a1_2_a5_3 (_ BitVec 11))
(declare-const a1_2_a5_4 (_ BitVec 11))
(declare-const a1_2_i3 (_ BitVec 11))
(declare-const a1_2_i7 (_ BitVec 11))
(declare-const a1_3_a5_0 (_ BitVec 11))
(declare-const a1_3_a5_1 (_ BitVec 11))
(declare-const a1_3_a5_2 (_ BitVec 11))
(declare-const a1_3_a5_3 (_ BitVec 11))
(declare-const a1_3_a5_4 (_ BitVec 11))
(declare-const a1_3_i3 (_ BitVec 11))
(declare-const a1_3_i7 (_ BitVec 11))
(declare-const i8 (_ BitVec 11))

; Domain constraints
(assert (and (bvsge a1_0_a5_0 #b00011010101) (bvsle a1_0_a5_0 #b00011101101)))
(assert (and (bvsge a1_0_a5_1 #b00011010101) (bvsle a1_0_a5_1 #b00011101101)))
(assert (and (bvsge a1_0_a5_2 #b00011010101) (bvsle a1_0_a5_2 #b00011101101)))
(assert (and (bvsge a1_0_a5_3 #b00011010101) (bvsle a1_0_a5_3 #b00011101101)))
(assert (and (bvsge a1_0_a5_4 #b00011010101) (bvsle a1_0_a5_4 #b00011101101)))
(assert (or (= a1_0_i3 #b00001010011) (= a1_0_i3 #b00110101101)))
(assert (or (= a1_0_i7 #b00000011110) (= a1_0_i7 #b00001001111) (= a1_0_i7 #b00100110101) (= a1_0_i7 #b01110011111)))
(assert (and (bvsge a1_1_a5_0 #b00011010101) (bvsle a1_1_a5_0 #b00011101101)))
(assert (and (bvsge a1_1_a5_1 #b00011010101) (bvsle a1_1_a5_1 #b00011101101)))
(assert (and (bvsge a1_1_a5_2 #b00011010101) (bvsle a1_1_a5_2 #b00011101101)))
(assert (and (bvsge a1_1_a5_3 #b00011010101) (bvsle a1_1_a5_3 #b00011101101)))
(assert (and (bvsge a1_1_a5_4 #b00011010101) (bvsle a1_1_a5_4 #b00011101101)))
(assert (or (= a1_1_i3 #b00001010011) (= a1_1_i3 #b00110101101)))
(assert (or (= a1_1_i7 #b00000011110) (= a1_1_i7 #b00001001111) (= a1_1_i7 #b00100110101) (= a1_1_i7 #b01110011111)))
(assert (and (bvsge a1_2_a5_0 #b00011010101) (bvsle a1_2_a5_0 #b00011101101)))
(assert (and (bvsge a1_2_a5_1 #b00011010101) (bvsle a1_2_a5_1 #b00011101101)))
(assert (and (bvsge a1_2_a5_2 #b00011010101) (bvsle a1_2_a5_2 #b00011101101)))
(assert (and (bvsge a1_2_a5_3 #b00011010101) (bvsle a1_2_a5_3 #b00011101101)))
(assert (and (bvsge a1_2_a5_4 #b00011010101) (bvsle a1_2_a5_4 #b00011101101)))
(assert (or (= a1_2_i3 #b00001010011) (= a1_2_i3 #b00110101101)))
(assert (or (= a1_2_i7 #b00000011110) (= a1_2_i7 #b00001001111) (= a1_2_i7 #b00100110101) (= a1_2_i7 #b01110011111)))
(assert (and (bvsge a1_3_a5_0 #b00011010101) (bvsle a1_3_a5_0 #b00011101101)))
(assert (and (bvsge a1_3_a5_1 #b00011010101) (bvsle a1_3_a5_1 #b00011101101)))
(assert (and (bvsge a1_3_a5_2 #b00011010101) (bvsle a1_3_a5_2 #b00011101101)))
(assert (and (bvsge a1_3_a5_3 #b00011010101) (bvsle a1_3_a5_3 #b00011101101)))
(assert (and (bvsge a1_3_a5_4 #b00011010101) (bvsle a1_3_a5_4 #b00011101101)))
(assert (or (= a1_3_i3 #b00001010011) (= a1_3_i3 #b00110101101)))
(assert (or (= a1_3_i7 #b00000011110) (= a1_3_i7 #b00001001111) (= a1_3_i7 #b00100110101) (= a1_3_i7 #b01110011111)))
(assert (and (bvsge i8 #b00011001111) (bvsle i8 #b00111110111)))

; Formula constraint
(assert (=> (and (or (bvsge a1_3_a5_1 a1_2_i3) (not (= a1_2_i7 (bvadd a1_2_a5_1 a1_1_a5_1)))) (not (bvsge a1_2_i7 a1_0_i7))) (bvslt a1_2_a5_1 a1_0_a5_2)))

(check-sat)