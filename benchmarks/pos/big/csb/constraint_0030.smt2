(set-logic QF_BV)

; Bit width chosen: 11 (covers range [47, 979] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a10_0 (_ BitVec 11))
(declare-const a10_1 (_ BitVec 11))
(declare-const a10_2 (_ BitVec 11))
(declare-const a10_3 (_ BitVec 11))
(declare-const a13_0 (_ BitVec 11))
(declare-const a13_1 (_ BitVec 11))
(declare-const a13_2 (_ BitVec 11))
(declare-const a13_3 (_ BitVec 11))
(declare-const a13_4 (_ BitVec 11))
(declare-const a13_5 (_ BitVec 11))
(declare-const a8_0 (_ BitVec 11))
(declare-const h1_a3_0 (_ BitVec 11))
(declare-const h1_a3_1 (_ BitVec 11))
(declare-const h1_a3_2 (_ BitVec 11))
(declare-const h1_a3_3 (_ BitVec 11))
(declare-const h1_a3_4 (_ BitVec 11))
(declare-const h1_a5_0_0 (_ BitVec 11))
(declare-const h1_a5_0_1 (_ BitVec 11))
(declare-const h1_a5_1_0 (_ BitVec 11))
(declare-const h1_a5_1_1 (_ BitVec 11))
(declare-const h1_a5_2_0 (_ BitVec 11))
(declare-const h1_a5_2_1 (_ BitVec 11))
(declare-const h1_a5_3_0 (_ BitVec 11))
(declare-const h1_a5_3_1 (_ BitVec 11))
(declare-const h1_i2 (_ BitVec 11))
(declare-const i12 (_ BitVec 11))

; Domain constraints
(assert (and (bvsge a10_0 #b01101100101) (bvsle a10_0 #b01101111000)))
(assert (and (bvsge a10_1 #b01101100101) (bvsle a10_1 #b01101111000)))
(assert (and (bvsge a10_2 #b01101100101) (bvsle a10_2 #b01101111000)))
(assert (and (bvsge a10_3 #b01101100101) (bvsle a10_3 #b01101111000)))
(assert (and (bvsge a13_0 #b01011100111) (bvsle a13_0 #b01101111011)))
(assert (and (bvsge a13_1 #b01011100111) (bvsle a13_1 #b01101111011)))
(assert (and (bvsge a13_2 #b01011100111) (bvsle a13_2 #b01101111011)))
(assert (and (bvsge a13_3 #b01011100111) (bvsle a13_3 #b01101111011)))
(assert (and (bvsge a13_4 #b01011100111) (bvsle a13_4 #b01101111011)))
(assert (and (bvsge a13_5 #b01011100111) (bvsle a13_5 #b01101111011)))
(assert (or (= a8_0 #b00101100010) (= a8_0 #b00111000110) (= a8_0 #b01111010011)))
(assert (or (= h1_a3_0 #b00010101110) (= h1_a3_0 #b00011000000) (= h1_a3_0 #b00110100110) (= h1_a3_0 #b01011011110)))
(assert (or (= h1_a3_1 #b00010101110) (= h1_a3_1 #b00011000000) (= h1_a3_1 #b00110100110) (= h1_a3_1 #b01011011110)))
(assert (or (= h1_a3_2 #b00010101110) (= h1_a3_2 #b00011000000) (= h1_a3_2 #b00110100110) (= h1_a3_2 #b01011011110)))
(assert (or (= h1_a3_3 #b00010101110) (= h1_a3_3 #b00011000000) (= h1_a3_3 #b00110100110) (= h1_a3_3 #b01011011110)))
(assert (or (= h1_a3_4 #b00010101110) (= h1_a3_4 #b00011000000) (= h1_a3_4 #b00110100110) (= h1_a3_4 #b01011011110)))
(assert (and (bvsge h1_a5_0_0 #b00000101111) (bvsle h1_a5_0_0 #b01011001011)))
(assert (and (bvsge h1_a5_0_1 #b00000101111) (bvsle h1_a5_0_1 #b01011001011)))
(assert (and (bvsge h1_a5_1_0 #b00000101111) (bvsle h1_a5_1_0 #b01011001011)))
(assert (and (bvsge h1_a5_1_1 #b00000101111) (bvsle h1_a5_1_1 #b01011001011)))
(assert (and (bvsge h1_a5_2_0 #b00000101111) (bvsle h1_a5_2_0 #b01011001011)))
(assert (and (bvsge h1_a5_2_1 #b00000101111) (bvsle h1_a5_2_1 #b01011001011)))
(assert (and (bvsge h1_a5_3_0 #b00000101111) (bvsle h1_a5_3_0 #b01011001011)))
(assert (and (bvsge h1_a5_3_1 #b00000101111) (bvsle h1_a5_3_1 #b01011001011)))
(assert (and (bvsge h1_i2 #b01000001000) (bvsle h1_i2 #b01000100100)))
(assert (and (bvsge i12 #b00101110011) (bvsle i12 #b01100010001)))

; Formula constraint
(assert (bvslt a13_5 a13_0))

(check-sat)