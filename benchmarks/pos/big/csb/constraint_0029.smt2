(declare-const i4 (_ BitVec 11))

; Domain constraints
(assert (or (= a1_0_0 #b00110001001) (= a1_0_0 #b00111001000) (= a1_0_0 #b01001001111) (= a1_0_0 #b01010111111)))
(assert (or (= a1_0_1 #b00110001001) (= a1_0_1 #b00111001000) (= a1_0_1 #b01001001111) (= a1_0_1 #b01010111111)))
(assert (or (= a1_0_2 #b00110001001) (= a1_0_2 #b00111001000) (= a1_0_2 #b01001001111) (= a1_0_2 #b01010111111)))
(assert (or (= a1_0_3 #b00110001001) (= a1_0_3 #b00111001000) (= a1_0_3 #b01001001111) (= a1_0_3 #b01010111111)))
(assert (or (= a1_1_0 #b00110001001) (= a1_1_0 #b00111001000) (= a1_1_0 #b01001001111) (= a1_1_0 #b01010111111)))
(assert (or (= a1_1_1 #b00110001001) (= a1_1_1 #b00111001000) (= a1_1_1 #b01001001111) (= a1_1_1 #b01010111111)))
(assert (or (= a1_1_2 #b00110001001) (= a1_1_2 #b00111001000) (= a1_1_2 #b01001001111) (= a1_1_2 #b01010111111)))
(assert (or (= a1_1_3 #b00110001001) (= a1_1_3 #b00111001000) (= a1_1_3 #b01001001111) (= a1_1_3 #b01010111111)))
(assert (or (= a1_2_0 #b00110001001) (= a1_2_0 #b00111001000) (= a1_2_0 #b01001001111) (= a1_2_0 #b01010111111)))
(assert (or (= a1_2_1 #b00110001001) (= a1_2_1 #b00111001000) (= a1_2_1 #b01001001111) (= a1_2_1 #b01010111111)))
(assert (or (= a1_2_2 #b00110001001) (= a1_2_2 #b00111001000) (= a1_2_2 #b01001001111) (= a1_2_2 #b01010111111)))
(assert (or (= a1_2_3 #b00110001001) (= a1_2_3 #b00111001000) (= a1_2_3 #b01001001111) (= a1_2_3 #b01010111111)))
(assert (or (= a1_3_0 #b00110001001) (= a1_3_0 #b00111001000) (= a1_3_0 #b01001001111) (= a1_3_0 #b01010111111)))
(assert (or (= a1_3_1 #b00110001001) (= a1_3_1 #b00111001000) (= a1_3_1 #b01001001111) (= a1_3_1 #b01010111111)))
(assert (or (= a1_3_2 #b00110001001) (= a1_3_2 #b00111001000) (= a1_3_2 #b01001001111) (= a1_3_2 #b01010111111)))
(assert (or (= a1_3_3 #b00110001001) (= a1_3_3 #b00111001000) (= a1_3_3 #b01001001111) (= a1_3_3 #b01010111111)))
(assert (or (= a1_4_0 #b00110001001) (= a1_4_0 #b00111001000) (= a1_4_0 #b01001001111) (= a1_4_0 #b01010111111)))
(assert (or (= a1_4_1 #b00110001001) (= a1_4_1 #b00111001000) (= a1_4_1 #b01001001111) (= a1_4_1 #b01010111111)))
(assert (or (= a1_4_2 #b00110001001) (= a1_4_2 #b00111001000) (= a1_4_2 #b01001001111) (= a1_4_2 #b01010111111)))
