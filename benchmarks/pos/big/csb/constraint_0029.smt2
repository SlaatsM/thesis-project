(set-logic QF_BV)

; Bit width chosen: 11 (covers range [393, 703] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a1_0_0 (_ BitVec 11))
(declare-const a1_0_1 (_ BitVec 11))
(declare-const a1_0_2 (_ BitVec 11))
(declare-const a1_0_3 (_ BitVec 11))
(declare-const a1_1_0 (_ BitVec 11))
(declare-const a1_1_1 (_ BitVec 11))
(declare-const a1_1_2 (_ BitVec 11))
