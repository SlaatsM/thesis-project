(assert (or (= a1_5_1 #b00110001001) (= a1_5_1 #b00111001000) (= a1_5_1 #b01001001111) (= a1_5_1 #b01010111111)))
(assert (or (= a1_5_2 #b00110001001) (= a1_5_2 #b00111001000) (= a1_5_2 #b01001001111) (= a1_5_2 #b01010111111)))
(assert (or (= a1_5_3 #b00110001001) (= a1_5_3 #b00111001000) (= a1_5_3 #b01001001111) (= a1_5_3 #b01010111111)))
(assert (and (bvsge i4 #b01001011001) (bvsle i4 #b01010110010)))

; Formula constraint
(assert (bvsgt a1_2_2 a1_5_1))

(check-sat)