(set-logic QF_BV)

; Bit width chosen: 11 (covers range [18, 958] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a10_0 (_ BitVec 11))
(declare-const a1_0_0_0 (_ BitVec 11))
(declare-const a1_0_0_1 (_ BitVec 11))
(declare-const a1_1_0_0 (_ BitVec 11))
(declare-const a1_1_0_1 (_ BitVec 11))
(declare-const a1_2_0_0 (_ BitVec 11))
(declare-const a1_2_0_1 (_ BitVec 11))
(declare-const a1_3_0_0 (_ BitVec 11))
(declare-const a1_3_0_1 (_ BitVec 11))
(declare-const a1_4_0_0 (_ BitVec 11))
(declare-const a1_4_0_1 (_ BitVec 11))
(declare-const a5_0_0_0 (_ BitVec 11))
(declare-const a5_0_0_1 (_ BitVec 11))
(declare-const a5_0_0_2 (_ BitVec 11))
(declare-const a5_1_0_0 (_ BitVec 11))
(declare-const a5_1_0_1 (_ BitVec 11))
(declare-const a5_1_0_2 (_ BitVec 11))
(declare-const a5_2_0_0 (_ BitVec 11))
(declare-const a5_2_0_1 (_ BitVec 11))
(declare-const a5_2_0_2 (_ BitVec 11))
(declare-const i9 (_ BitVec 11))

; Domain constraints
(assert (and (bvsge a10_0 #b01001110011) (bvsle a10_0 #b01110111110)))
(assert (and (bvsge a1_0_0_0 #b01010100000) (bvsle a1_0_0_0 #b01110110011)))
(assert (and (bvsge a1_0_0_1 #b01010100000) (bvsle a1_0_0_1 #b01110110011)))
(assert (and (bvsge a1_1_0_0 #b01010100000) (bvsle a1_1_0_0 #b01110110011)))
(assert (and (bvsge a1_1_0_1 #b01010100000) (bvsle a1_1_0_1 #b01110110011)))
(assert (and (bvsge a1_2_0_0 #b01010100000) (bvsle a1_2_0_0 #b01110110011)))
(assert (and (bvsge a1_2_0_1 #b01010100000) (bvsle a1_2_0_1 #b01110110011)))
(assert (and (bvsge a1_3_0_0 #b01010100000) (bvsle a1_3_0_0 #b01110110011)))
(assert (and (bvsge a1_3_0_1 #b01010100000) (bvsle a1_3_0_1 #b01110110011)))
(assert (and (bvsge a1_4_0_0 #b01010100000) (bvsle a1_4_0_0 #b01110110011)))
(assert (and (bvsge a1_4_0_1 #b01010100000) (bvsle a1_4_0_1 #b01110110011)))
(assert (or (= a5_0_0_0 #b00100111101) (= a5_0_0_0 #b00101011101) (= a5_0_0_0 #b00101100111) (= a5_0_0_0 #b00101110110) (= a5_0_0_0 #b00110000010)))
(assert (or (= a5_0_0_1 #b00100111101) (= a5_0_0_1 #b00101011101) (= a5_0_0_1 #b00101100111) (= a5_0_0_1 #b00101110110) (= a5_0_0_1 #b00110000010)))
(assert (or (= a5_0_0_2 #b00100111101) (= a5_0_0_2 #b00101011101) (= a5_0_0_2 #b00101100111) (= a5_0_0_2 #b00101110110) (= a5_0_0_2 #b00110000010)))
(assert (or (= a5_1_0_0 #b00100111101) (= a5_1_0_0 #b00101011101) (= a5_1_0_0 #b00101100111) (= a5_1_0_0 #b00101110110) (= a5_1_0_0 #b00110000010)))
(assert (or (= a5_1_0_1 #b00100111101) (= a5_1_0_1 #b00101011101) (= a5_1_0_1 #b00101100111) (= a5_1_0_1 #b00101110110) (= a5_1_0_1 #b00110000010)))
(assert (or (= a5_1_0_2 #b00100111101) (= a5_1_0_2 #b00101011101) (= a5_1_0_2 #b00101100111) (= a5_1_0_2 #b00101110110) (= a5_1_0_2 #b00110000010)))
(assert (or (= a5_2_0_0 #b00100111101) (= a5_2_0_0 #b00101011101) (= a5_2_0_0 #b00101100111) (= a5_2_0_0 #b00101110110) (= a5_2_0_0 #b00110000010)))
(assert (or (= a5_2_0_1 #b00100111101) (= a5_2_0_1 #b00101011101) (= a5_2_0_1 #b00101100111) (= a5_2_0_1 #b00101110110) (= a5_2_0_1 #b00110000010)))
(assert (or (= a5_2_0_2 #b00100111101) (= a5_2_0_2 #b00101011101) (= a5_2_0_2 #b00101100111) (= a5_2_0_2 #b00101110110) (= a5_2_0_2 #b00110000010)))
(assert (or (= i9 #b00000010010) (and (bvsge i9 #b00001110010) (bvsle i9 #b00010101010)) (= i9 #b01011110010)))

; Formula constraint
(assert (bvslt a1_0_0_0 a1_4_0_0))

(check-sat)