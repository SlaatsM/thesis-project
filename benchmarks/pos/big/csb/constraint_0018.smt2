(assert (or (= a1_2_0 #b00000000011111001) (= a1_2_0 #b00000000100000111) (= a1_2_0 #b00000000110001101) (= a1_2_0 #b00000000110110110) (= a1_2_0 #b00000001000011001)))
(assert (or (= a1_2_1 #b00000000011111001) (= a1_2_1 #b00000000100000111) (= a1_2_1 #b00000000110001101) (= a1_2_1 #b00000000110110110) (= a1_2_1 #b00000001000011001)))
(assert (or (= a1_2_2 #b00000000011111001) (= a1_2_2 #b00000000100000111) (= a1_2_2 #b00000000110001101) (= a1_2_2 #b00000000110110110) (= a1_2_2 #b00000001000011001)))
(assert (or (= a1_3_0 #b00000000011111001) (= a1_3_0 #b00000000100000111) (= a1_3_0 #b00000000110001101) (= a1_3_0 #b00000000110110110) (= a1_3_0 #b00000001000011001)))
(assert (or (= a1_3_1 #b00000000011111001) (= a1_3_1 #b00000000100000111) (= a1_3_1 #b00000000110001101) (= a1_3_1 #b00000000110110110) (= a1_3_1 #b00000001000011001)))
