(assert (and (bvsge i4 #b00000000010001001) (bvsle i4 #b00000001110010001)))

; Formula constraint
(assert (or (bvsgt (bvadd (bvadd (bvmul #b00000000001000010 i4) #b00000000001100000) a1_2_1) #b11111111110100101) (and (bvsgt #b00000000000000101 i4) (bvsgt a1_4_2 (bvadd #b11111111110110101 (bvadd i4 #b11111111110011100))))))

(check-sat)