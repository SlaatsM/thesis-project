(set-logic QF_BV)

; Bit width chosen: 11 (covers range [51, 962] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a6_0_0 (_ BitVec 11))
(declare-const a6_0_1 (_ BitVec 11))
(declare-const a6_0_2 (_ BitVec 11))
(declare-const a6_0_3 (_ BitVec 11))
(declare-const a6_0_4 (_ BitVec 11))
(declare-const a6_1_0 (_ BitVec 11))
(declare-const a6_1_1 (_ BitVec 11))
(declare-const a6_1_2 (_ BitVec 11))
(declare-const a6_1_3 (_ BitVec 11))
(declare-const a6_1_4 (_ BitVec 11))
(declare-const a6_2_0 (_ BitVec 11))
(declare-const a6_2_1 (_ BitVec 11))
(declare-const a6_2_2 (_ BitVec 11))
(declare-const a6_2_3 (_ BitVec 11))
(declare-const a6_2_4 (_ BitVec 11))
(declare-const h1_i2 (_ BitVec 11))
(declare-const h1_i3 (_ BitVec 11))
(declare-const h1_i4 (_ BitVec 11))
(declare-const i5 (_ BitVec 11))

; Domain constraints
(assert (and (bvsge a6_0_0 #b01001010110) (bvsle a6_0_0 #b01011101010)))
(assert (and (bvsge a6_0_1 #b01001010110) (bvsle a6_0_1 #b01011101010)))
(assert (and (bvsge a6_0_2 #b01001010110) (bvsle a6_0_2 #b01011101010)))
(assert (and (bvsge a6_0_3 #b01001010110) (bvsle a6_0_3 #b01011101010)))
(assert (and (bvsge a6_0_4 #b01001010110) (bvsle a6_0_4 #b01011101010)))
(assert (and (bvsge a6_1_0 #b01001010110) (bvsle a6_1_0 #b01011101010)))
(assert (and (bvsge a6_1_1 #b01001010110) (bvsle a6_1_1 #b01011101010)))
(assert (and (bvsge a6_1_2 #b01001010110) (bvsle a6_1_2 #b01011101010)))
(assert (and (bvsge a6_1_3 #b01001010110) (bvsle a6_1_3 #b01011101010)))
(assert (and (bvsge a6_1_4 #b01001010110) (bvsle a6_1_4 #b01011101010)))
(assert (and (bvsge a6_2_0 #b01001010110) (bvsle a6_2_0 #b01011101010)))
(assert (and (bvsge a6_2_1 #b01001010110) (bvsle a6_2_1 #b01011101010)))
(assert (and (bvsge a6_2_2 #b01001010110) (bvsle a6_2_2 #b01011101010)))
(assert (and (bvsge a6_2_3 #b01001010110) (bvsle a6_2_3 #b01011101010)))
(assert (and (bvsge a6_2_4 #b01001010110) (bvsle a6_2_4 #b01011101010)))
(assert (and (bvsge h1_i2 #b01000011001) (bvsle h1_i2 #b01011011100)))
(assert (and (bvsge h1_i3 #b01100010010) (bvsle h1_i3 #b01101010100)))
(assert (or (= h1_i4 #b01100001011) (= h1_i4 #b01110011000) (= h1_i4 #b01111000010)))
(assert (and (bvsge i5 #b00000110011) (bvsle i5 #b01100110010)))

; Formula constraint
(assert (bvsge a6_1_3 a6_2_0))

(check-sat)