(declare-const h13_i14 (_ BitVec 18))
(declare-const h13_i15 (_ BitVec 18))
(declare-const h13_i16 (_ BitVec 18))
(declare-const h9_a10_0_0 (_ BitVec 18))
(declare-const h9_a10_0_1 (_ BitVec 18))
(declare-const h9_a10_0_2 (_ BitVec 18))
(declare-const h9_a10_1_0 (_ BitVec 18))
(declare-const h9_a10_1_1 (_ BitVec 18))
(declare-const h9_a10_1_2 (_ BitVec 18))
(declare-const h9_a10_2_0 (_ BitVec 18))
(declare-const h9_a10_2_1 (_ BitVec 18))
(declare-const h9_a10_2_2 (_ BitVec 18))

; Domain constraints
(assert (and (bvsge a5_0 #b111111111000101111) (bvsle a5_0 #b000000000001010000)))
(assert (and (bvsge a5_1 #b111111111000101111) (bvsle a5_1 #b000000000001010000)))
(assert (and (bvsge a5_2 #b111111111000101111) (bvsle a5_2 #b000000000001010000)))
(assert (and (bvsge a5_3 #b111111111000101111) (bvsle a5_3 #b000000000001010000)))
(assert (and (bvsge a7_0 #b111111110101110111) (bvsle a7_0 #b000000000010000010)))
(assert (and (bvsge a7_1 #b111111110101110111) (bvsle a7_1 #b000000000010000010)))
(assert (and (bvsge h1_h2_i3 #b111111110100100011) (bvsle h1_h2_i3 #b000000001111011101)))
(assert (and (bvsge h1_i4 #b111111111010000101) (bvsle h1_i4 #b000000000100010101)))
(assert (and (bvsge h13_i14 #b111111110000111110) (bvsle h13_i14 #b111111110001001111)))
(assert (or (and (bvsge h13_i15 #b111111110010011000) (bvsle h13_i15 #b000000001000011001)) (= h13_i15 #b000000001110100001)))
(assert (or (= h13_i16 #b111111110100100010) (= h13_i16 #b111111111100001001) (= h13_i16 #b000000000111001011) (= h13_i16 #b000000000111111011) (= h13_i16 #b000000001000100110)))
(assert (and (bvsge h9_a10_0_0 #b111111110000110110) (bvsle h9_a10_0_0 #b000000001000011001)))
(assert (and (bvsge h9_a10_0_1 #b111111110000110110) (bvsle h9_a10_0_1 #b000000001000011001)))
(assert (and (bvsge h9_a10_0_2 #b111111110000110110) (bvsle h9_a10_0_2 #b000000001000011001)))
(assert (and (bvsge h9_a10_1_0 #b111111110000110110) (bvsle h9_a10_1_0 #b000000001000011001)))
(assert (and (bvsge h9_a10_1_1 #b111111110000110110) (bvsle h9_a10_1_1 #b000000001000011001)))
(assert (and (bvsge h9_a10_1_2 #b111111110000110110) (bvsle h9_a10_1_2 #b000000001000011001)))
(assert (and (bvsge h9_a10_2_0 #b111111110000110110) (bvsle h9_a10_2_0 #b000000001000011001)))
(assert (and (bvsge h9_a10_2_1 #b111111110000110110) (bvsle h9_a10_2_1 #b000000001000011001)))
(assert (and (bvsge h9_a10_2_2 #b111111110000110110) (bvsle h9_a10_2_2 #b000000001000011001)))

; Formula constraint
(assert (and (and (or (not (= #b111111111111010000 (bvmul #b111111111111111111 h1_i4))) (bvsle (bvmul #b000000000001011011 h9_a10_2_0) #b111111111111111111)) (and (bvsgt (bvsub (bvadd a5_3 #b000000000001001110) a5_2) (bvmul #b000000000001001110 h1_i4)) (bvsgt a5_2 (bvmul #b111111111111000111 h9_a10_0_0)))) (not (and (bvsgt h9_a10_1_1 h9_a10_0_1) (bvsge #b111111111110100111 (bvmul #b111111111111100110 h9_a10_2_0))))))

(check-sat)