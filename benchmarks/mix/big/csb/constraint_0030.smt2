(set-logic QF_BV)

; Bit width chosen: 18 (covers range [-88270, 55290] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a5_0 (_ BitVec 18))
(declare-const a5_1 (_ BitVec 18))
(declare-const a5_2 (_ BitVec 18))
(declare-const a5_3 (_ BitVec 18))
(declare-const a7_0 (_ BitVec 18))
(declare-const a7_1 (_ BitVec 18))
(declare-const h1_h2_i3 (_ BitVec 18))
