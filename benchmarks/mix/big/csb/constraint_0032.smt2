(declare-const a9_0_a12_2 (_ BitVec 11))
(declare-const a9_0_i14 (_ BitVec 11))
(declare-const a9_1_a12_0 (_ BitVec 11))
(declare-const a9_1_a12_1 (_ BitVec 11))
