; Formula constraint
(assert (=> (not (and (bvsgt (bvsub a9_3_a12_2 #b11111010101) a9_2_a12_1) (bvsgt a9_4_i14 (bvadd #b00001000101 a9_1_a12_1)))) (=> (not (= #b00001010010 #b00000111001)) (=> (bvsgt #b00001011100 a9_1_a12_2) (bvsgt h1_i2 #b00000011111)))))

(check-sat)