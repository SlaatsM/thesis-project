; Domain constraints
(assert (and (bvsge a9_0_a12_0 #b11110111100) (bvsle a9_0_a12_0 #b00000110000)))
(assert (and (bvsge a9_0_a12_1 #b11110111100) (bvsle a9_0_a12_1 #b00000110000)))
(assert (and (bvsge a9_0_a12_2 #b11110111100) (bvsle a9_0_a12_2 #b00000110000)))
(assert (and (bvsge a9_0_i14 #b10101111011) (bvsle a9_0_i14 #b11011001011)))
(assert (and (bvsge a9_1_a12_0 #b11110111100) (bvsle a9_1_a12_0 #b00000110000)))
(assert (and (bvsge a9_1_a12_1 #b11110111100) (bvsle a9_1_a12_1 #b00000110000)))
(assert (and (bvsge a9_1_a12_2 #b11110111100) (bvsle a9_1_a12_2 #b00000110000)))
(assert (and (bvsge a9_1_i14 #b10101111011) (bvsle a9_1_i14 #b11011001011)))
(assert (and (bvsge a9_2_a12_0 #b11110111100) (bvsle a9_2_a12_0 #b00000110000)))
(assert (and (bvsge a9_2_a12_1 #b11110111100) (bvsle a9_2_a12_1 #b00000110000)))
(assert (and (bvsge a9_2_a12_2 #b11110111100) (bvsle a9_2_a12_2 #b00000110000)))
(assert (and (bvsge a9_2_i14 #b10101111011) (bvsle a9_2_i14 #b11011001011)))
(assert (and (bvsge a9_3_a12_0 #b11110111100) (bvsle a9_3_a12_0 #b00000110000)))
(assert (and (bvsge a9_3_a12_1 #b11110111100) (bvsle a9_3_a12_1 #b00000110000)))
(assert (and (bvsge a9_3_a12_2 #b11110111100) (bvsle a9_3_a12_2 #b00000110000)))
(assert (and (bvsge a9_3_i14 #b10101111011) (bvsle a9_3_i14 #b11011001011)))
(assert (and (bvsge a9_4_a12_0 #b11110111100) (bvsle a9_4_a12_0 #b00000110000)))
(assert (and (bvsge a9_4_a12_1 #b11110111100) (bvsle a9_4_a12_1 #b00000110000)))
(assert (and (bvsge a9_4_a12_2 #b11110111100) (bvsle a9_4_a12_2 #b00000110000)))
(assert (and (bvsge a9_4_i14 #b10101111011) (bvsle a9_4_i14 #b11011001011)))
(assert (and (bvsge h1_i2 #b10001111110) (bvsle h1_i2 #b00111101011)))
(assert (and (bvsge h4_i5 #b11101111100) (bvsle h4_i5 #b11110001001)))
(assert (and (bvsge h4_i6 #b11001100000) (bvsle h4_i6 #b01111001011)))
