(set-logic QF_BV)

; Bit width chosen: 11 (covers range [-924, 826] found in domains and all intermediate sub-expressions, so prevents wraparound)

; Variable declarations
(declare-const a1_0 (_ BitVec 11))
(declare-const a1_1 (_ BitVec 11))
(declare-const a1_2 (_ BitVec 11))
(declare-const a1_3 (_ BitVec 11))
(declare-const a3_0_0 (_ BitVec 11))
(declare-const a3_0_1 (_ BitVec 11))
(declare-const a3_0_2 (_ BitVec 11))
(declare-const a3_1_0 (_ BitVec 11))
(declare-const a3_1_1 (_ BitVec 11))
(declare-const a3_1_2 (_ BitVec 11))
(declare-const a3_2_0 (_ BitVec 11))
(declare-const a3_2_1 (_ BitVec 11))
(declare-const a3_2_2 (_ BitVec 11))
(declare-const a3_3_0 (_ BitVec 11))
(declare-const a3_3_1 (_ BitVec 11))
(declare-const a3_3_2 (_ BitVec 11))
(declare-const a3_4_0 (_ BitVec 11))
(declare-const a3_4_1 (_ BitVec 11))
(declare-const a3_4_2 (_ BitVec 11))
(declare-const a7_0_i10 (_ BitVec 11))
(declare-const a7_0_i11 (_ BitVec 11))
(declare-const a7_0_i12 (_ BitVec 11))
(declare-const i6 (_ BitVec 11))

; Domain constraints
(assert (or (= a1_0 #b01000110111) (= a1_0 #b01100111010)))
(assert (or (= a1_1 #b01000110111) (= a1_1 #b01100111010)))
(assert (or (= a1_2 #b01000110111) (= a1_2 #b01100111010)))
(assert (or (= a1_3 #b01000110111) (= a1_3 #b01100111010)))
(assert (and (bvsge a3_0_0 #b11000001001) (bvsle a3_0_0 #b01011000101)))
(assert (and (bvsge a3_0_1 #b11000001001) (bvsle a3_0_1 #b01011000101)))
(assert (and (bvsge a3_0_2 #b11000001001) (bvsle a3_0_2 #b01011000101)))
(assert (and (bvsge a3_1_0 #b11000001001) (bvsle a3_1_0 #b01011000101)))
(assert (and (bvsge a3_1_1 #b11000001001) (bvsle a3_1_1 #b01011000101)))
(assert (and (bvsge a3_1_2 #b11000001001) (bvsle a3_1_2 #b01011000101)))
(assert (and (bvsge a3_2_0 #b11000001001) (bvsle a3_2_0 #b01011000101)))
(assert (and (bvsge a3_2_1 #b11000001001) (bvsle a3_2_1 #b01011000101)))
(assert (and (bvsge a3_2_2 #b11000001001) (bvsle a3_2_2 #b01011000101)))
(assert (and (bvsge a3_3_0 #b11000001001) (bvsle a3_3_0 #b01011000101)))
(assert (and (bvsge a3_3_1 #b11000001001) (bvsle a3_3_1 #b01011000101)))
(assert (and (bvsge a3_3_2 #b11000001001) (bvsle a3_3_2 #b01011000101)))
(assert (and (bvsge a3_4_0 #b11000001001) (bvsle a3_4_0 #b01011000101)))
(assert (and (bvsge a3_4_1 #b11000001001) (bvsle a3_4_1 #b01011000101)))
(assert (and (bvsge a3_4_2 #b11000001001) (bvsle a3_4_2 #b01011000101)))
(assert (and (bvsge a7_0_i10 #b00110101110) (bvsle a7_0_i10 #b00111011000)))
(assert (or (= a7_0_i11 #b10111010110) (= a7_0_i11 #b00000001011) (= a7_0_i11 #b00100001111)))
(assert (or (and (bvsge a7_0_i12 #b10110100100) (bvsle a7_0_i12 #b00010010011)) (= a7_0_i12 #b01100110101)))
(assert (or (= i6 #b10001100100) (= i6 #b11000001111) (= i6 #b00100000000) (= i6 #b00111110010)))

; Formula constraint
(assert (bvsgt #b11111100001 a3_3_2))

(check-sat)