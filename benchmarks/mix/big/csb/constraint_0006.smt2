(declare-const h1_a6_3_2 (_ BitVec 11))
(declare-const h1_a6_3_3 (_ BitVec 11))
(declare-const h1_a6_3_4 (_ BitVec 11))
(declare-const i10 (_ BitVec 11))
(declare-const i9 (_ BitVec 11))

; Domain constraints
(assert (or (= a11_0 #b10100100011) (= a11_0 #b11101011000) (= a11_0 #b00010101111)))
(assert (or (= a11_1 #b10100100011) (= a11_1 #b11101011000) (= a11_1 #b00010101111)))
(assert (or (= a11_2 #b10100100011) (= a11_2 #b11101011000) (= a11_2 #b00010101111)))
(assert (or (= a11_3 #b10100100011) (= a11_3 #b11101011000) (= a11_3 #b00010101111)))
(assert (or (= a11_4 #b10100100011) (= a11_4 #b11101011000) (= a11_4 #b00010101111)))
(assert (or (= a11_5 #b10100100011) (= a11_5 #b11101011000) (= a11_5 #b00010101111)))
(assert (and (bvsge h1_a4_0 #b10010101100) (bvsle h1_a4_0 #b10011011101)))
(assert (and (bvsge h1_a4_1 #b10010101100) (bvsle h1_a4_1 #b10011011101)))
(assert (and (bvsge h1_a4_2 #b10010101100) (bvsle h1_a4_2 #b10011011101)))
(assert (and (bvsge h1_a6_0_0 #b10111011000) (bvsle h1_a6_0_0 #b00100110000)))
(assert (and (bvsge h1_a6_0_1 #b10111011000) (bvsle h1_a6_0_1 #b00100110000)))
(assert (and (bvsge h1_a6_0_2 #b10111011000) (bvsle h1_a6_0_2 #b00100110000)))
(assert (and (bvsge h1_a6_0_3 #b10111011000) (bvsle h1_a6_0_3 #b00100110000)))
(assert (and (bvsge h1_a6_0_4 #b10111011000) (bvsle h1_a6_0_4 #b00100110000)))
(assert (and (bvsge h1_a6_1_0 #b10111011000) (bvsle h1_a6_1_0 #b00100110000)))
(assert (and (bvsge h1_a6_1_1 #b10111011000) (bvsle h1_a6_1_1 #b00100110000)))
(assert (and (bvsge h1_a6_1_2 #b10111011000) (bvsle h1_a6_1_2 #b00100110000)))
(assert (and (bvsge h1_a6_1_3 #b10111011000) (bvsle h1_a6_1_3 #b00100110000)))
(assert (and (bvsge h1_a6_1_4 #b10111011000) (bvsle h1_a6_1_4 #b00100110000)))
(assert (and (bvsge h1_a6_2_0 #b10111011000) (bvsle h1_a6_2_0 #b00100110000)))
(assert (and (bvsge h1_a6_2_1 #b10111011000) (bvsle h1_a6_2_1 #b00100110000)))
(assert (and (bvsge h1_a6_2_2 #b10111011000) (bvsle h1_a6_2_2 #b00100110000)))
(assert (and (bvsge h1_a6_2_3 #b10111011000) (bvsle h1_a6_2_3 #b00100110000)))
(assert (and (bvsge h1_a6_2_4 #b10111011000) (bvsle h1_a6_2_4 #b00100110000)))
(assert (and (bvsge h1_a6_3_0 #b10111011000) (bvsle h1_a6_3_0 #b00100110000)))
(assert (and (bvsge h1_a6_3_1 #b10111011000) (bvsle h1_a6_3_1 #b00100110000)))
(assert (and (bvsge h1_a6_3_2 #b10111011000) (bvsle h1_a6_3_2 #b00100110000)))
(assert (and (bvsge h1_a6_3_3 #b10111011000) (bvsle h1_a6_3_3 #b00100110000)))
(assert (and (bvsge h1_a6_3_4 #b10111011000) (bvsle h1_a6_3_4 #b00100110000)))
(assert (or (and (bvsge i10 #b10001100111) (bvsle i10 #b10010000111)) (and (bvsge i10 #b11000010010) (bvsle i10 #b00100110110)) (= i10 #b00101101111)))
(assert (and (bvsge i9 #b00110001010) (bvsle i9 #b01110000101)))

; Formula constraint
(assert (bvsge h1_a6_3_4 #b00001010110))

(check-sat)